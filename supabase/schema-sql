-- Idempotent Kuresoi South Teachers Welfare Group schema update.
-- This script avoids duplicate enum/type, table, index, FK, trigger and policy errors.
-- It does not drop tables or delete existing rows.
-- IMPORTANT: Existing tables are assumed to have the columns defined in the original schema.

begin;

create extension if not exists pgcrypto;

do $$ begin
  create type public.school_level as enum ('ECDE','Primary','Junior School','Secondary');
exception when duplicate_object then null; end $$;
do $$ begin
  create type public.school_status as enum ('pending','approved','rejected','suspended');
exception when duplicate_object then null; end $$;
do $$ begin
  create type public.member_role as enum ('teacher','school_admin','county_admin','welfare_admin','super_admin');
exception when duplicate_object then null; end $$;
do $$ begin
  create type public.fundraiser_status as enum ('draft','active','closed','cancelled');
exception when duplicate_object then null; end $$;
do $$ begin
  create type public.payment_status as enum ('pending','paid','failed','cancelled','reversed');
exception when duplicate_object then null; end $$;

create table if not exists public.profiles (
 id uuid primary key references auth.users(id) on delete cascade,
 full_name text not null, phone text,
 role public.member_role not null default 'teacher',
 school_id uuid, show_name_on_public_reports boolean not null default false,
 created_at timestamptz not null default now(), updated_at timestamptz not null default now()
);
create table if not exists public.schools (
 id uuid primary key default gen_random_uuid(), name text not null, county text not null,
 sub_county text, level public.school_level not null,
 status public.school_status not null default 'pending',
 created_by uuid not null references auth.users(id),
 approved_by uuid references auth.users(id), approved_at timestamptz,
 created_at timestamptz not null default now(), unique (name, county, level)
);
do $$ begin
 alter table public.profiles add constraint profiles_school_fk
 foreign key (school_id) references public.schools(id) on delete set null;
exception when duplicate_object then null; end $$;

create table if not exists public.school_memberships (
 id uuid primary key default gen_random_uuid(),
 school_id uuid not null references public.schools(id) on delete cascade,
 user_id uuid not null references public.profiles(id) on delete cascade,
 position_title text not null default 'Teacher',
 membership_status text not null default 'active' check (membership_status in ('pending','active','left')),
 joined_at timestamptz not null default now(), unique(school_id,user_id)
);
create table if not exists public.school_officials (
 id uuid primary key default gen_random_uuid(),
 school_id uuid not null references public.schools(id) on delete cascade,
 position_title text not null check(position_title in ('Headteacher','Deputy Headteacher','Principal','Deputy Principal','Other')),
 full_name text not null, updated_by uuid references auth.users(id),
 updated_at timestamptz not null default now(), unique(school_id,position_title)
);
create table if not exists public.fundraisers (
 id uuid primary key default gen_random_uuid(), title text not null, mission text not null,
 beneficiary_names text, target_amount numeric(12,2),
 default_amount numeric(12,2) not null default 200 check(default_amount > 0),
 status public.fundraiser_status not null default 'draft',
 opens_at timestamptz not null default now(), closes_at timestamptz,
 created_by uuid not null references auth.users(id), created_at timestamptz not null default now()
);
create table if not exists public.school_targets (
 id uuid primary key default gen_random_uuid(),
 fundraiser_id uuid not null references public.fundraisers(id) on delete cascade,
 school_id uuid not null references public.schools(id) on delete cascade,
 amount_per_teacher numeric(12,2) check(amount_per_teacher is null or amount_per_teacher > 0),
 school_target numeric(12,2) check(school_target is null or school_target >= 0),
 unique(fundraiser_id,school_id)
);
create table if not exists public.contributions (
 id uuid primary key default gen_random_uuid(),
 fundraiser_id uuid not null references public.fundraisers(id),
 school_id uuid not null references public.schools(id),
 user_id uuid not null references public.profiles(id),
 amount numeric(12,2) not null check(amount > 0), phone text not null,
 public_name_consent boolean not null default false,
 payment_status public.payment_status not null default 'pending',
 checkout_request_id text unique, merchant_request_id text,
 mpesa_receipt_number text unique, result_code text, result_description text,
 paid_at timestamptz, created_at timestamptz not null default now()
);
create table if not exists public.school_teachers (
 id uuid primary key default gen_random_uuid(),
 school_id uuid not null references public.schools(id) on delete cascade,
 full_name text not null check(length(trim(full_name)) between 2 and 140),
 phone text, position_title text not null default 'Teacher',
 institution_section text not null check(institution_section in ('ECDE','Primary','Junior School','Secondary')),
 linked_user_id uuid references public.profiles(id) on delete set null,
 added_by uuid not null references auth.users(id),
 created_at timestamptz not null default now(), updated_at timestamptz not null default now()
);
create index if not exists school_teachers_school_name_idx on public.school_teachers(school_id, full_name);
create table if not exists public.audit_logs (
 id bigint generated always as identity primary key,
 actor_id uuid references auth.users(id), action text not null, table_name text not null,
 record_id text, details jsonb not null default '{}'::jsonb, created_at timestamptz not null default now()
);

create index if not exists schools_status_name_idx on public.schools(status,name);
create index if not exists memberships_user_idx on public.school_memberships(user_id);
create index if not exists memberships_school_idx on public.school_memberships(school_id);
create index if not exists contributions_fundraiser_school_idx on public.contributions(fundraiser_id,school_id);
create index if not exists contributions_status_idx on public.contributions(payment_status);
create index if not exists contributions_user_idx on public.contributions(user_id);

create or replace function public.handle_new_user()
returns trigger language plpgsql security definer set search_path=''
as $$
begin
 insert into public.profiles(id,full_name)
 values(new.id, coalesce(nullif(new.raw_user_meta_data->>'full_name',''),'Teacher'));
 return new;
end;
$$;
drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created after insert on auth.users
for each row execute procedure public.handle_new_user();

create or replace function public.has_role(allowed public.member_role[])
returns boolean language sql stable security definer set search_path=''
as $$ select exists(select 1 from public.profiles p where p.id=auth.uid() and p.role=any(allowed)); $$;
create or replace function public.is_school_member(target_school uuid)
returns boolean language sql stable security definer set search_path=''
as $$ select exists(select 1 from public.school_memberships m where m.school_id=target_school and m.user_id=auth.uid() and m.membership_status='active'); $$;

alter table public.profiles enable row level security;
alter table public.schools enable row level security;
alter table public.school_memberships enable row level security;
alter table public.school_officials enable row level security;
alter table public.school_teachers enable row level security;
alter table public.fundraisers enable row level security;
alter table public.school_targets enable row level security;
alter table public.contributions enable row level security;
alter table public.audit_logs enable row level security;

revoke all on public.profiles,public.schools,public.school_memberships,public.school_officials,public.school_teachers,public.fundraisers,public.school_targets,public.contributions,public.audit_logs from anon,authenticated;
grant select on public.schools,public.fundraisers,public.school_targets to anon,authenticated;
grant select,update on public.profiles to authenticated;
grant select,insert on public.schools to authenticated;
grant update(status) on public.schools to authenticated;
grant select,insert,update,delete on public.school_memberships to authenticated;
grant select,insert,update on public.school_officials to authenticated;
grant select,insert,update,delete on public.school_teachers to authenticated;
grant select on public.contributions to authenticated,anon;
grant select on public.audit_logs to authenticated;

drop policy if exists "Public can see approved schools" on public.schools;
create policy "Public can see approved schools" on public.schools for select to anon,authenticated using(status='approved');
drop policy if exists "Any signed-in user can add a school" on public.schools;
create policy "Any signed-in user can add a school" on public.schools for insert to authenticated with check(status='approved' and created_by=auth.uid());
drop policy if exists "Any signed-in user can remove a school from directory" on public.schools;
create policy "Any signed-in user can remove a school from directory" on public.schools for update to authenticated using(status='approved') with check(status='suspended');
drop policy if exists "Admins manage schools" on public.schools;
create policy "Admins manage schools" on public.schools for all to authenticated using(public.has_role(array['super_admin','welfare_admin']::public.member_role[])) with check(public.has_role(array['super_admin','welfare_admin']::public.member_role[]));

drop policy if exists "Users read own profile" on public.profiles;
create policy "Users read own profile" on public.profiles for select to authenticated using(id=auth.uid() or public.has_role(array['super_admin','welfare_admin','county_admin']::public.member_role[]));
drop policy if exists "Users update own profile" on public.profiles;
create policy "Users update own profile" on public.profiles for update to authenticated using(id=auth.uid()) with check(id=auth.uid());
drop policy if exists "Welfare admins read profiles" on public.profiles;
create policy "Welfare admins read profiles" on public.profiles for select to authenticated using(public.has_role(array['super_admin','welfare_admin','county_admin']::public.member_role[]));

drop policy if exists "School members see memberships" on public.school_memberships;
create policy "School members see memberships" on public.school_memberships for select to authenticated using(user_id=auth.uid() or public.is_school_member(school_id) or public.has_role(array['super_admin','welfare_admin','county_admin']::public.member_role[]));
drop policy if exists "Teachers join approved schools" on public.school_memberships;
create policy "Teachers join approved schools" on public.school_memberships for insert to authenticated with check(user_id=auth.uid() and membership_status='active' and exists(select 1 from public.schools s where s.id=school_id and s.status='approved'));
drop policy if exists "Any school member manages memberships" on public.school_memberships;
create policy "Any school member manages memberships" on public.school_memberships for update to authenticated using(public.is_school_member(school_id)) with check(public.is_school_member(school_id));
drop policy if exists "Any school member removes memberships" on public.school_memberships;
create policy "Any school member removes memberships" on public.school_memberships for delete to authenticated using(public.is_school_member(school_id));

drop policy if exists "School members read teacher directory" on public.school_teachers;
create policy "School members read teacher directory" on public.school_teachers for select to authenticated using(public.is_school_member(school_id) or public.has_role(array['super_admin','welfare_admin','county_admin']::public.member_role[]));
drop policy if exists "Any school member adds teachers" on public.school_teachers;
create policy "Any school member adds teachers" on public.school_teachers for insert to authenticated with check(public.is_school_member(school_id) and added_by=auth.uid());
drop policy if exists "Any school member edits teachers" on public.school_teachers;
create policy "Any school member edits teachers" on public.school_teachers for update to authenticated using(public.is_school_member(school_id)) with check(public.is_school_member(school_id));
drop policy if exists "Any school member removes teachers" on public.school_teachers;
create policy "Any school member removes teachers" on public.school_teachers for delete to authenticated using(public.is_school_member(school_id));

drop policy if exists "Approved school officials public" on public.school_officials;
create policy "Approved school officials public" on public.school_officials for select to anon,authenticated using(exists(select 1 from public.schools s where s.id=school_id and s.status='approved'));
drop policy if exists "Authorized school leaders edit officials" on public.school_officials;
create policy "Authorized school leaders edit officials" on public.school_officials for all to authenticated using(public.is_school_member(school_id) and public.has_role(array['school_admin','super_admin','welfare_admin']::public.member_role[])) with check(public.is_school_member(school_id) and public.has_role(array['school_admin','super_admin','welfare_admin']::public.member_role[]));

drop policy if exists "Public sees active fundraisers" on public.fundraisers;
create policy "Public sees active fundraisers" on public.fundraisers for select to anon,authenticated using(status='active');
drop policy if exists "Welfare admins manage fundraisers" on public.fundraisers;
create policy "Welfare admins manage fundraisers" on public.fundraisers for all to authenticated using(public.has_role(array['super_admin','welfare_admin']::public.member_role[])) with check(public.has_role(array['super_admin','welfare_admin']::public.member_role[]));
drop policy if exists "Public sees targets for active fundraisers" on public.school_targets;
create policy "Public sees targets for active fundraisers" on public.school_targets for select to anon,authenticated using(exists(select 1 from public.fundraisers f where f.id=fundraiser_id and f.status='active'));
drop policy if exists "Welfare admins manage targets" on public.school_targets;
create policy "Welfare admins manage targets" on public.school_targets for all to authenticated using(public.has_role(array['super_admin','welfare_admin']::public.member_role[])) with check(public.has_role(array['super_admin','welfare_admin']::public.member_role[]));

drop policy if exists "Teachers see own contributions" on public.contributions;
create policy "Teachers see own contributions" on public.contributions for select to authenticated using(user_id=auth.uid() or public.has_role(array['super_admin','welfare_admin','county_admin']::public.member_role[]));
drop policy if exists "Admins read audit logs" on public.audit_logs;
create policy "Admins read audit logs" on public.audit_logs for select to authenticated using(public.has_role(array['super_admin','welfare_admin']::public.member_role[]));

commit;

